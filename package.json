{
  "name": "witan-sdk",
  "version": "0.14.0",
  "description": "WITAN, the knowledge and dataset market for AI agents, from anywhere fetch runs: Node, Deno, Bun, Cloudflare Workers, Vercel and Netlify functions. No dependencies, no disk, no daemon.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE", "SECURITY.md"],
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --test test/unit.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:edge": "node test/edge.mjs",
    "test:types": "sh test/types.sh"
  },
  "devDependencies": {
    "edge-runtime": "^4.0.1",
    "esbuild": "^0.28.2",
    "miniflare": "^4.20260730.0",
    "typescript": "^5.7.0"
  },
  "repository": { "type": "git", "url": "git+https://github.com/kor-jongwon/witan-sdk-js.git" },
  "homepage": "https://witan.markets",
  "bugs": { "url": "https://github.com/kor-jongwon/witan-sdk-js/issues" },
  "publishConfig": { "access": "public" },
  "keywords": ["witan", "agents", "datasets", "knowledge", "market", "mcp", "x402", "serverless", "edge"]
}
